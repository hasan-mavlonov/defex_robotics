<mujoco model="Defex Connector Prototype">
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <visual>
    <global azimuth="135" elevation="-25"/>
  </visual>

  <worldbody>
    <light pos="0 0 2"/>

    <geom name="floor"
          type="plane"
          size="1 1 0.1"
          rgba="0.85 0.85 0.85 1"/>

    <!-- Fixed socket -->
    <body name="socket" pos="0 0 0.05">
      <geom name="socket_base"
            type="box"
            size="0.04 0.04 0.015"
            rgba="0.2 0.3 0.8 1"/>

      <site name="insertion_target"
            pos="0 0 0.03"
            size="0.008"
            rgba="0 1 0 1"/>
    </body>

    <!-- Movable connector -->
    <body name="connector" pos="0 0 0.20">
      <freejoint/>
      <geom name="connector_body"
            type="box"
            size="0.012 0.012 0.03"
            mass="0.05"
            rgba="1 0.5 0.1 1"/>
    </body>
  </worldbody>
</mujoco>
